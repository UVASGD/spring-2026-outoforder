        {
            "character": "Virgo",
            "speakerSprite": "VirgoEyes",
            "dialogue": "Could this scale be a bit off?"
        },
        {
            "character": "ASTA",
            "speakerSprite": "AstaEyes",
            "dialogue": "Aha. I know."
        },
        {
            "character": "Virgo",
            "speakerSprite": "VirgoEyes",
            "dialogue": "...What is it?"
        },
        {
            "character": "ASTA",
            "speakerSprite": "AstaEyes",
            "dialogue": "Could you have been hiding from me that you were a body builder back Outside?"
        },
        {
            "character": "Virgo",
            "speakerSprite": "VirgoEyes",
            "dialogue": "..."
        },
        {
            "character": "ASTA",
            "speakerSprite": "AstaEyes",
            "dialogue": "I have recently downloaded an updated humor module. This is what you call 'teasing,' isn't it?"
        },
        {
            "character": "Virgo",
            "speakerSprite": "VirgoEyes",
            "dialogue": "..."
        },
        {
            "character": "Virgo",
            "speakerSprite": "VirgoEyes",
            "dialogue": "Please,"
        },
        {
            "character": "Virgo",
            "speakerSprite": "VirgoEyes",
            "dialogue": "... don't do that again.",
