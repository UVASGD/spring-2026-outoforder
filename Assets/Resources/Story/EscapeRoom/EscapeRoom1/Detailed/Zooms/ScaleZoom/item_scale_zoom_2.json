            "dialogue": "..."
        },
        {
            "character": "Virgo",
            "speakerSprite": "VirgoEyes",
            "dialogue": "...Huh?"
        },
        {
            "character": "ASTA",
            "speakerSprite": "AstaEyes",
            "dialogue": "200 pounds?"
