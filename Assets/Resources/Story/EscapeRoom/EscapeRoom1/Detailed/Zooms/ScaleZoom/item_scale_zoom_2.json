        {
            "character": "ASTA",
            "speakerSprite": "AstaEyes",
            "dialogue": "But 200 pounds, huh."
        },
        {
            "character": "ASTA",
            "speakerSprite": "AstaEyes",
            "dialogue": "That is quite heavy for a human, is it not?"
        },
        {
            "character": "ASTA",
            "speakerSprite": "AstaEyes",
            "dialogue": "But you did not seem to even break a sweat."
        },
        {
            "character": "Virgo",
            "speakerSprite": "VirgoEyes",
